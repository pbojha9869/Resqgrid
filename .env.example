# ResQGrid Environment Variables
# Copy this file to .env and fill in your values

# Real-time hazard feeds (Open-Meteo weather, GloFAS river floods,
# USGS earthquakes, NASA EONET events) require NO API keys and are always active.
#
# true  = also merge clearly-labeled "DEMO DATA" points onto the map
# false = show only real-time / government-source data
DEMO_MODE=false

# Backend port
PORT=4000

# IMD API credentials (if available)
IMD_API_KEY=

# NDMA SACHET API credentials (if available)
NDMA_API_KEY=

# CWC API credentials (if available)
CWC_API_KEY=
# Optional self-hosted OSRM routing server (defaults to https://router.project-osrm.org)
OSRM_BASE_URL=
